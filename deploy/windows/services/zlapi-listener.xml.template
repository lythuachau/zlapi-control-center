<service>
  <id>zlapi-listener</id>
  <name>ZLAPI Control Center Listener</name>
  <description>Long-lived Zalo WebSocket listener supervisor.</description>
  <executable>{{SERVICE_ROOT}}\current\.venv\Scripts\python.exe</executable>
  <arguments>-m control_center.listener</arguments>
  <workingdirectory>{{SERVICE_ROOT}}\shared</workingdirectory>
  <env name="PYTHONUNBUFFERED" value="1"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>60sec</stoptimeout>
  <!-- Stop the base-Python child before its venv launcher to prevent orphans. -->
  <stopparentprocessfirst>false</stopparentprocessfirst>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>{{DATA_ROOT}}\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMM</zipDateFormat>
  </log>
</service>
