ZLAPI_APP_ENV=production
TZ=Asia/Ho_Chi_Minh
ZLAPI_DATABASE_URL=postgresql+psycopg://USER:REPLACE_ME@HOST:5432/DATABASE?sslmode=require
ZLAPI_SESSION_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ZLAPI_DATA_DIR=/var/lib/zlapi-control-center
ZLAPI_DOMAIN=control.example.com
ZLAPI_TRUSTED_HOSTS=control.example.com,localhost,127.0.0.1
ZLAPI_COOKIE_SECURE=true
ZLAPI_AUTO_CREATE_SCHEMA=false
ZLAPI_DATABASE_CAP_BYTES=1073741824
ZLAPI_MAX_UPLOAD_MB=25
ZLAPI_INBOUND_DOWNLOAD_MAX_MB=250
ZLAPI_GIF_LIBRARY_MAX_ITEMS=200
ZLAPI_GIF_LIBRARY_MAX_BYTES=2147483648
ZLAPI_FFMPEG_PATH=/usr/bin/ffmpeg
ZLAPI_FFPROBE_PATH=/usr/bin/ffprobe
ZLAPI_MEDIA_PROCESS_TIMEOUT_SECONDS=90
ZLAPI_ARCHIVE_AFTER_DAYS=90
ZLAPI_API_KEY_REQUESTS_PER_MINUTE=120
ZLAPI_SESSION_REQUESTS_PER_MINUTE=300
ZLAPI_LOGIN_ATTEMPTS_PER_MINUTE=10
ZLAPI_PG_DUMP_PATH=/usr/bin/pg_dump
ZLAPI_RCLONE_REMOTE=
ZLAPI_ALERT_WEBHOOK_URL=
ZLAPI_BOOTSTRAP_ADMIN_USERNAME=admin
ZLAPI_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_ONE_TIME_PASSWORD
